VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_GTM_ID=

# Klaviyo — list ID is not secret. The private key is.
# Never prefix the private key with VITE_ (that ships it to the browser).
# Key scopes: lists:write, profiles:write, subscriptions:write, events:write
# Live webhook reads Supabase Edge Function secrets, not Vite:
#   supabase secrets set KLAVIYO_PRIVATE_API_KEY=pk_xxxxxxxx
#   supabase secrets set KLAVIYO_LIST_ID=RsVDpj
KLAVIYO_LIST_ID=RsVDpj
KLAVIYO_PRIVATE_API_KEY=
